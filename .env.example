NUXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Legacy/current Map Viewer POC credential only.
# Current SitumViewer still reads this value from public runtime config.
# DO NOT reuse this public credential for new REST/domain backend integrations.
# Plan 010 will freeze the private Nitro credential + browser Viewer auth contract before Plan 011 starts.
NUXT_PUBLIC_SITUM_API_KEY=

# Public identifier for the building loaded by the current Viewer.
NUXT_PUBLIC_SITUM_BUILDING_ID=

NUXT_SESSION_PASSWORD=replace-with-at-least-32-characters
# Set false only for local/manual HTTP testing; keep true/default behind HTTPS.
NUXT_SESSION_COOKIE_SECURE=true
AUTH_EMAIL=owner@example.com
AUTH_PASSWORD_HASH=
