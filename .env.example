DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Private server-side ClickHouse HTTP connection.
# Host-run Nuxt uses the shared local Docker exposure on port 8124.
# Never move these values under runtimeConfig.public.
CLICKHOUSE_URL=http://localhost:8124
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=situm_explore_analytics

# Browser-visible Situm Map Viewer credential.
# Use the minimum Situm role that still supports the retained Viewer behavior.
# This value is public by design because Nuxt exposes NUXT_PUBLIC_* to the browser.
# Never reuse it as the server REST credential.
NUXT_PUBLIC_SITUM_API_KEY=

# Private Nitro credential for all Situm server operations.
# Never expose this value through public runtime config or browser code.
NUXT_SITUM_API_KEY=

# Public identifier for the building loaded by the current Viewer.
NUXT_PUBLIC_SITUM_BUILDING_ID=

NUXT_SESSION_PASSWORD=replace-with-at-least-32-characters
# Set false only for local/manual HTTP testing; keep true/default behind HTTPS.
NUXT_SESSION_COOKIE_SECURE=true

# Optional OpenTelemetry OTLP/HTTP export to the existing local collector.
OTEL_SERVICE_NAME=situm-explore
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Optional Google OAuth preparation. The /auth/google route is disabled unless both credentials are set.
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
# Set when automatic callback discovery is unsuitable.
NUXT_OAUTH_GOOGLE_REDIRECT_URL=
