NUXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# POC only: one Situm API key shared by the browser viewer and later Situm API integrations.
# The POC may use a Read & Write key here for speed. Replace/revoke it after the POC.
NUXT_PUBLIC_SITUM_API_KEY=
# Optional to fill manually. If blank locally, the agent may discover it with
# GET https://api.situm.com/api/v1/buildings using X-API-KEY, then write the selected ID to local .env only.
NUXT_PUBLIC_SITUM_BUILDING_ID=
NUXT_SESSION_PASSWORD=replace-with-at-least-32-characters
AUTH_EMAIL=owner@example.com
AUTH_PASSWORD_HASH=
